{
  "welcomeFile": "/comsaperpfiorifiledrivemanage/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/http/(.*)$",
      "target": "/http/$1",
      "destination": "CPI_DRIVE_FILE",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "destination": "ui5",
      "authenticationType": "none"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "destination": "ui5",
      "authenticationType": "none"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}