<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="pageHome" class="fmPage" enableScrolling="true">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://menu2" type="Transparent" tooltip="Menu" press=".onSideNavButtonPress" />
                    <Title text="Google Drive Manager" level="H2" />
                </contentLeft>
                <contentRight>
                    <Button icon="sap-icon://refresh" type="Transparent" tooltip="Synchroniser" press=".loadDriveFiles" />
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <VBox class="fmContent">

                <!-- Titre de section -->
                <VBox class="fmSectionHead">
                    <Title text="Vue d'ensemble" level="H1" titleStyle="H2" />
                    <Text text="Dernière synchronisation avec SAP CPI : {ui>/lastSync}" class="fmSubText" />
                </VBox>

                <!-- KPI -->
                <core:Fragment fragmentName="com.saperp.fiori.filedrivemanage.view.fragments.KpiTiles" type="XML" />

                <!-- Répartition + Derniers fichiers -->
                <core:Fragment fragmentName="com.saperp.fiori.filedrivemanage.view.fragments.DashboardInsights" type="XML" />

            </VBox>
        </content>
    </Page>

</core:FragmentDefinition>