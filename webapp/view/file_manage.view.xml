<mvc:View
    controllerName="com.saperp.fiori.filedrivemanage.controller.file_manage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    displayBlock="true"
    height="100%">

    <tnt:ToolPage id="toolPage" class="fmToolPage">

        <!-- SIDEBAR -->
        <tnt:sideContent>
            <core:Fragment fragmentName="com.saperp.fiori.filedrivemanage.view.fragments.SideNavigation" type="XML" />
        </tnt:sideContent>

        <!-- CONTENU PRINCIPAL -->
        <tnt:mainContents>
            <NavContainer id="navContainer" initialPage="pageHome" height="100%">
                <core:Fragment fragmentName="com.saperp.fiori.filedrivemanage.view.fragments.HomePage" type="XML" />
                <core:Fragment fragmentName="com.saperp.fiori.filedrivemanage.view.fragments.FilesPage" type="XML" />
            </NavContainer>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>

